# Dependencies
node_modules

# Build outputs
.next
.next-harness
.next-dev
.turbo
dist
storybook-static
apps/*/build

# Environment
.env
.env.*
!.env.example

# Vercel
.vercel

# PM2 (machine-specifieke absolute paden)
ecosystem.config.js

# macOS
.DS_Store

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# tokens.json is committed — Tokens Studio GitHub sync target
# packages/tokens/build: generated output is committed, intermediate files are not
# (_merged.json = primitives-pass, _merged.<mode>.json = één per rollaag-mode)
packages/tokens/build/_merged*.json
# packages/rowtrack-tokens leest apps/rowtrack/tokens/tokens.json en levert de
# web-helft; zelfde regel: theme.css en roles.mjs committen, de merge-pass niet.
packages/rowtrack-tokens/build/_merged*.json

# Manuele backups
*.backup

# Lokale dev-bestanden
apps/watermark-remover/.iopaint.log
apps/watermark-remover/start.sh
apps/rowtrack/package-lock.json
.expo/
*.tsbuildinfo

# Agent-worktrees (isolation: "worktree") worden ín de repo aangemaakt.
.claude/worktrees/
