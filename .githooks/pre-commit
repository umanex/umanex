#!/bin/bash
# .githooks/pre-commit — houdt gegenereerde artefacten in sync vóór elke commit.
#
# Per app die in DEZE commit gewijzigd is (geen cross-app ruis) draait:
#  1. Context-snapshot regenereren + stagen (via scripts/gen-snapshot.sh).
#  2. Design tokens: constants/ herbouwen uit tokens.json + stagen, zodat de
#     gegenereerde output nooit stil wegdrijft van de token-bron. Activeert
#     alleen voor apps met een "tokens:build"-script én een constants/-map.
#  3. Parallel-werk-signaal: melden dat er onvastgelegd werk in een ándere app ligt.
#     Waarschuwt alleen — blokkeren doet .githooks/commit-msg, en pas wanneer dat
#     andere werk effectief in de commit belandt.
#
# En vóór dat alles: de branch-guard hieronder.
#
# Canonieke bron: umanex-os/templates/githooks-pre-commit. Gesynct naar
# <klant-repo>/.githooks/pre-commit en geactiveerd via core.hooksPath=.githooks
# (zet scripts/sync-os.sh automatisch). Dependency-vrij — geen husky.

# 0. Branch-guard — nooit rechtstreeks op main, nooit op een losse HEAD.
#
# "Commit nooit direct op main" stond als proza in CLAUDE.md. Proza verliest van
# gemak: de commit die dit vangt was er één die per ongeluk op main landde terwijl
# er in dezelfde working tree aan een ándere app gewerkt werd.
#
# De losse-HEAD-tak dekt een linked worktree af die zónder `-b` op een commit of op
# `origin/main` is gezet (`git worktree add <pad> origin/main`, of een `checkout origin/main`
# erin): die staat op een losse HEAD, en zonder deze guard zou een commit daar stil
# verdwijnen zodra je wegcheckt. Met `-b` (het recept in CLAUDE.md) speelt dit niet.
#
# Rebase, cherry-pick en een lopende merge draaien per definitie op een losse HEAD
# of committen op de huidige branch — die laat de guard met rust, anders zou hij
# doodgewone git-operaties breken.
git_dir="$(git rev-parse --git-dir)"
if [ ! -d "$git_dir/rebase-merge" ] && [ ! -d "$git_dir/rebase-apply" ] \
   && [ ! -f "$git_dir/CHERRY_PICK_HEAD" ] && [ ! -f "$git_dir/MERGE_HEAD" ]; then
  current_branch="$(git symbolic-ref --short -q HEAD || true)"

  if [ -z "$current_branch" ]; then
    echo "✗ Losse HEAD — je zit op geen enkele branch, dus deze commit raakt zoek."
    echo "  Start je taak eerst: git checkout -b <type>/<korte-beschrijving>"
    exit 1
  fi

  if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
    echo "✗ Niet rechtstreeks op $current_branch committen."
    echo "  Werk op een branch: git checkout -b <type>/<korte-beschrijving>"
    echo "  (types: feature · fix · chore · docs · refactor)"
    exit 1
  fi
fi

# 1. Scratch-guard — een wegwerpbestand hoort niet in een commit.
#
# GEMETEN op 2026-08-20 in Luminus (`git show --stat 8861a5e`): zeven
# `apps/fleet-manager/scripts/.tmp-*.mjs` van parallel draaiende sub-agents reisden mee in
# één `git add -A`. Ze werden pas opgemerkt aan de `Warning: 7 uncommitted changes` van
# `gh pr create` — ná het pushen.
#
# Waarom een hook en niet .gitignore: Luminus kreeg achteraf `apps/*/scripts/.tmp-*`, maar
# dat is één repo en één map. Gemeten op 2026-08-21 stageren Columba, umanex-apps en
# umanex-os zo'n bestand nog zonder enige weerstand. Deze guard reist met de laag mee en
# geldt overal, op elk pad, ook bij `git add -f`.
#
# Bewust nauw: alleen een PUNT-geprefixt wegwerppatroon. Een dotfile die `.tmp-`, `.scratch`,
# `.probe` of `.refute` heet is per conventie verborgen werkmateriaal — een echt bestand
# heet zo niet. Breder matchen (`tmp-*`, `*-probe.mjs`) zou test-fixtures raken die legitiem
# zo heten, en een wachter die geregeld vals alarm slaat leer je negeren.
#
# Blokkeert, en bewust zonder trailer-escape: de juiste actie is hier altijd dezelfde
# — unstage. Wil je zo'n bestand écht bewaren, dan hoort het een naam te dragen die geen
# wegwerpbestand belooft.
scratch=""
for f in $(git diff --cached --name-only --diff-filter=ACM || true); do
  case "${f##*/}" in
    .tmp-*|.scratch*|.probe*|.refute*) scratch="$scratch $f"; continue ;;
  esac
  # Een agent-worktree is het tweede geval, en het venijnigste: `isolation: "worktree"`
  # zet hem ÍN de repo (.claude/worktrees/agent-<id>/). GEMETEN op 2026-08-21: van de vier
  # repos negeert alleen Columba dat pad, dus elders wordt de isolatie-map zelf untracked
  # repo-inhoud die een `git add -A` zo meeneemt — de klasse die de isolatie net sloot,
  # opnieuw binnengelaten langs de achterdeur. Een .gitignore-regel dekt dit ook, maar die
  # reist niet mee met de laag; deze hook wel.
  case "$f" in
    .claude/worktrees/*|*/.claude/worktrees/*) scratch="$scratch $f" ;;
  esac
done

if [ -n "$scratch" ]; then
  echo ""
  echo "✗ Commit gestopt — wegwerpbestand(en) staan gestaged:"
  for f in $scratch; do echo "    $f"; done
  echo ""
  echo "  Zo'n bestand komt doorgaans van een parallel draaiende agent of een eigen probe."
  echo "  Het is geen werk dat je wilt bewaren, en in de geschiedenis is het niet meer weg."
  echo ""
  echo "    git restore --staged$(printf ' %s' $scratch)"
  echo ""
  exit 1
fi

# 2. HANDOFF-check-signaal — legt een nieuwe open entry een check vast of een staat?
#    Waarschuwt, blokkeert niet.
#
#    Dit blok staat bewust vóór de app-poort hieronder. Een `HANDOFF.md` leeft in de
#    repo-root net zo goed als in een app, en `[ -z "$changed_apps" ] && exit 0` zou het
#    dan overslaan bij precies de meest voorkomende vorm: een commit op root. Dat is geen
#    theorie — de eerste versie stond eronder en zweeg in de tegenproef.
#
#    De faalvorm: `Bevinding` is per definitie een waarneming van toen ("de guard matcht
#    alleen Tailwind-syntax", "CLAUDE.md is 32 123 chars"). Zodra de code eronder verandert
#    is die zin onwaar en merkt niets het — de SessionStart-hook speelt het item elke
#    ochtend af als openstaand werk. Op 2026-08-10 stond tien van de zesendertig
#    rowtrack-entries zo verkeerd open; één ervan lokte vijf dagen na zijn oplossing alsnog
#    een productvraag uit die al beantwoord was.
#
#    Alleen op wat deze commit TOEVOEGT. Bestaande entries zonder `Check` zijn er tientallen;
#    daarop afgaan zou de guard permanent laten piepen, en een wachter die altijd afgaat leer
#    je vooral negeren. Aanwezigheid is machinaal te toetsen, betekenis niet: of de check
#    ergens naar kíjkt blijft mensenwerk.
# Paden NUL-gescheiden en mét R: `for f in $(… | grep)` splitste een pad met een spatie in
# twee fragmenten (twee valse meldingen), liet een pad met een niet-ASCII-teken stil vallen
# (git quoteert dat pad, dus de `$`-anker van de grep miste) en zag een hernoemd bestand
# helemaal niet (`--diff-filter=ACM` laat R weg, en git detecteert renames standaard).
# Gemeten 2026-09-07 door het review-panel, op beide kanten. Zelfde vorm in 2b en 2c.
staged_paths() { git diff --cached --name-only -z --diff-filter=ACMR; }

zonder_check=""
while IFS= read -r -d '' f; do
  case "$f" in HANDOFF.md|*/HANDOFF.md) ;; *) continue ;; esac
  # Per toegevoegd entry-blok: staat er tussen de toegevoegde regels een `Check`?
  missing=$(git diff --cached -U0 -- "$f" \
    | awk '
        # Alleen toegevoegde regels tellen. Een entry-kop staat links uitgelijnd, zodat het
        # format-voorbeeld in de template-kop (vier spaties ingesprongen) niet meetelt.
        /^\+## 20[0-9][0-9]-/ {
          if (open_entry && is_open && !has_check) n++
          open_entry = 1; has_check = 0; is_open = 0; next
        }
        /^\+- \*\*Check:\*\*/        { has_check = 1; next }
        /^\+- \*\*Status:\*\* *open/ { is_open = 1; next }
        END { if (open_entry && is_open && !has_check) n++; print n + 0 }
      ')
  [ "${missing:-0}" -gt 0 ] 2>/dev/null && zonder_check="$zonder_check $f"
done < <(staged_paths)

if [ -n "$zonder_check" ]; then
  echo "⚠ Nieuwe open HANDOFF-entry zonder 'Check'-regel in:$zonder_check"
  echo "  Een entry die de staat van de code vastlegt veroudert stil — hij komt daarna"
  echo "  elke ochtend terug als openstaand werk, ook nadat het opgelost is."
  echo "  Schrijf de check op: een commando, of een vraag met een eenduidig antwoord."
fi

# 2b. Acceptatie-signaal — draagt een nieuw vinkje in een briefing zijn bewijs?
#     Waarschuwt, blokkeert niet. Zelfde plek en zelfde reden als het HANDOFF-blok
#     hierboven: een briefing kan in de root én in een app staan.
#
#     De faalvorm: een acceptatie-item is een bewering over het ding, en `- [x]` werd
#     gezet op de herinnering van de bouwstap. Gemeten op Soda+ (2026-08-25): zeventien
#     van negentien items afgevinkt, vijf ervan sprak het bestand tegen — "CTA's op één
#     hoogte" bij 288 px spreiding, "≤ 2 zinnen" bij drie. Een vinkje mét `bewijs:` in
#     de regel kan nog steeds liegen, maar dwingt een meting af die iemand kan nalezen.
#
#     Alleen op toegevoegde `- [x]`-regels in `*.tcebc.md`. Aanwezigheid van het woord
#     is machinaal te toetsen; of het bewijs iets meet, blijft mensenwerk.
zonder_bewijs=""
while IFS= read -r -d '' f; do
  case "$f" in *.tcebc.md) ;; *) continue ;; esac
  n_zb=$(git diff --cached -U0 -- "$f" \
    | awk '/^\+ *- \[[xX]\]/ && !/bewijs:/ { n++ } END { print n + 0 }')
  [ "${n_zb:-0}" -gt 0 ] 2>/dev/null && zonder_bewijs="$zonder_bewijs $f ($n_zb)"
done < <(staged_paths)

if [ -n "$zonder_bewijs" ]; then
  echo "⚠ Acceptatie-item(s) afgevinkt zonder 'bewijs:' in:$zonder_bewijs"
  echo "  Een vinkje zonder meting is een bewering, geen validatie — op Soda+ stond het"
  echo "  vijf keer verkeerd op negentien. Zet het bewijs ín de regel:"
  echo "    - [x] CTA's op één hoogte — bewijs: y=612 op 02–08 (figma_execute)"
fi

# 2b-bis. As-mix-signaal — mengt een acceptatie-item een inhoudelijke claim met een
#     procedurele? Waarschuwt, blokkeert niet. De commit-tijd tegenhanger van
#     `~/.claude/hooks/acceptatie-guard.sh`: die vuurt bij het schrijven, deze vangt ook
#     wat met de hand in een editor is aangepast.
#
#     GEMETEN (2026-09-07, 78 briefings / 629 items in umanex-apps): 49% van de items
#     draagt twee of meer beweringen die elk een eigen meting vragen. Een leestekenregex
#     vangt daar maar de helft van (recall 51%), want het dominante mechanisme is
#     juxtapositie zónder voegwoord. Het betrouwbaarste énkele signaal bleek de as-mix:
#     een inhoudelijke claim geniet aan een procedurele — "Portrait-gedrag ongewijzigd;
#     tsc groen". Die twee helften delen nooit een instrument, dus het groene commando
#     draagt routineus het vinkje voor de helft die niemand bekeken heeft.
#
#     Bewust NAUW: procedureel woord ÉN scheidingsteken op dezelfde regel. Een variant op
#     elke puntkomma vuurt op 22% van alle items en leert vooral hoe je hem wegleest.
as_mix=""
while IFS= read -r -d '' f; do
  case "$f" in *.tcebc.md) ;; *) continue ;; esac
  n_am=$(git diff --cached -U0 -- "$f" | awk '
    /^\+ *- \[[ xX]\]/ {
      kop = $0; sub(/— bewijs:.*/, "", kop)
      if (kop ~ /tsc|type-?check|typecheck|lint|build|exit 0|compileert/ && kop ~ /;|·| \+ /) n++
    }
    END { print n + 0 }')
  [ "${n_am:-0}" -gt 0 ] 2>/dev/null && as_mix="$as_mix $f ($n_am)"
done < <(staged_paths)

if [ -n "$as_mix" ]; then
  echo "⚠ Acceptatie-item(s) mengen een inhoudelijke claim met een procedurele in:$as_mix"
  echo "  Eén item, één meting. \`tsc groen\` en een visuele claim delen nooit een instrument,"
  echo "  dus het groene commando draagt het vinkje voor de helft die niemand bekeken heeft."
  echo "  Splits ze — de procedurele helft krijgt zijn eigen regel."
fi

# 2c. Briefing-status-signaal — draagt een aangeraakte briefing een status uit het
#     vocabulaire van de triade? Waarschuwt, blokkeert niet. Zelfde plek als 2a/2b: een
#     briefing kan in de root én in een app staan.
#
#     De faalvorm: de triade kent drie statussen (gepland → gebouwd → gevalideerd) en niets
#     bewaakte het woord. Gemeten 2026-09-07 over 197 briefings in vier repo's: 64 gevalideerd,
#     59 gebouwd, 10 gepland, 1 zónder Status en 63 met een van veertien eigen woorden
#     ("In uitvoering", "uitgevoerd", "geïmplementeerd", "draft", "ready", "concept", "akkoord").
#     De enige telling die zegt of de cyclus
#     sluit — hoeveel briefings halen `gevalideerd` — was daardoor niet te maken; die telling
#     staat nu in doctor.sh en leest alleen deze drie woorden.
#
#     Op aanraking, niet op de hele repo — dezelfde reden als het verify-pad-signaal: de
#     bestaande afwijkers zijn er tientallen, en een wachter die permanent afgaat leer je
#     negeren. Leest de gestagede inhoud (`git show :pad`), niet de working tree.
#     De parser leest drie schrijfwijzen — `- **Status:** x`, `| **Status** | x |` en kaal
#     `Status: x` — en slaat codeblocks over. De eerste versie las alleen de lijstvorm en
#     meldde 34 briefings als "zonder Status" waarvan er 33 wél een Status droegen (gemeten
#     2026-09-07 door het review-panel over 197 briefings). Dezelfde awk staat in
#     scripts/doctor.sh (blok 6b); wijzig ze samen.
status_af=""
while IFS= read -r -d '' f; do
  case "$f" in *.tcebc.md) ;; *) continue ;; esac
  st="$(git show ":$f" 2>/dev/null \
    | awk '/^```/ { blok = !blok; next } blok { next }
           { sub(/\r$/, "") }
           match($0, /^[[:space:]]*(- )?\*\*Status:?\*\*:?[[:space:]]*/) { v = substr($0, RLENGTH + 1) }
           match($0, /^\| *(\*\*)?Status(\*\*)? *\| */)              { v = substr($0, RLENGTH + 1) }
           match($0, /^Status: */)                                     { v = substr($0, RLENGTH + 1) }
           v != "" { gsub(/\*/, "", v); sub(/[[:space:]|].*/, "", v); gsub(/[.,;:]+$/, "", v)
                     print tolower(v); exit }')"
  case "$st" in
    gepland|gebouwd|gevalideerd) ;;
    "") status_af="$status_af $f (geen Status)" ;;
    *)  status_af="$status_af $f ('$st')" ;;
  esac
done < <(staged_paths)

if [ -n "$status_af" ]; then
  echo "⚠ Briefing-status buiten het vocabulaire in:$status_af"
  echo "  De triade kent drie statussen — gepland → gebouwd → gevalideerd — en alleen die"
  echo "  drie tellen mee in de telling van doctor.sh. Een eigen woord of geen Status zegt"
  echo "  niets over of de cyclus sloot. Zet in het metadata-blok: - **Status:** gebouwd"
fi

# `D` hoort erbij. Een commit die alleen verwijdert raakt de app net zo goed, en juist een
# delete maakt de context-snapshot ongeldig: die blijft anders een bestand als `gekoppeld`
# vermelden dat niet meer bestaat. Zonder de D sloeg zo'n commit alle vier de app-blokken
# hieronder over — geen snapshot, geen token-sync, geen parallel-werk- en geen
# verify-pad-signaal. De zusterguard `.githooks/commit-msg` telde deletes al wél mee.
# 3. Naamruimte-signaal — een kaal `#N` is dubbelzinnig zodra de tekst reist.
#
#    Waarschuwt, blokkeert niet, en kijkt alleen naar regels die je in DEZE commit
#    tóevoegt — niet naar wat er al stond. Een oud bestand aanraken mag geen lawine
#    van legacy-treffers geven; dezelfde "op aanraking"-logica als de signalen hieronder.
#
#    Waarom: umanex-os reist naar elke klant-repo, en een PR-nummer is per repo. Gemeten
#    op 2026-09-07: van de verwijzingen in umanex-os bestónden er **19 van 19** óók in
#    umanex-apps, en zes wezen aantoonbaar naar umanex-apps terwijl umanex-os dat nummer
#    niet eens kán hebben. Een lezer in Columba lost `#112` dus op naar een derde PR die
#    niemand bedoeld heeft, zonder één foutmelding.
#
#    Code-spans op één regel gaan eruit (de `sed` hieronder), want een tekst die uitlegt
#    wat een kaal nummer is, draagt er per definitie eentje als voorbeeld — een guard die
#    op zijn eigen uitleg blaft, leert vooral dat je hem mag negeren. Meerregelige
#    codeblokken ziet deze regel-voor-regel-check niet; die dekt scripts/refs-check.mjs,
#    dat óók aan GitHub vraagt of het nummer bestaat.
#
#    De fix is GitHub's eigen cross-repo-syntax: `umanex-apps#372` in plaats van `#372`.
#    Die rendert als een echte link én noemt het systeem dat het nummer uitgaf.
#
#    Scope: precies wat de sync kopieert — in umanex-os `CLAUDE.md`, `profiles/` en de
#    skills; in een klant-repo `.umanex-os/` en `.claude/skills/`.
#    De eigen backlog van een klant-repo verwijst legitiem kaal naar zijn eigen PR's en
#    blijft dus buiten schot.
#    Alleen `.md`: anders zou dít bestand bij zijn eigen commit klagen over de
#    voorbeeldnummers in de uitleg hierboven — het meetbereik dat de meting bevat.
#    De pathspec gaat via `set --` zodat een pad met een glob niet door woordsplitsing hoeft.
if [ -f templates/githooks-pre-commit ]; then
  # umanex-os zelf: alleen wat de sync naar een klant-repo kopieert. Zijn eigen
  # BACKLOG/HANDOFF/LEARNINGS blijven lokaal — daar dekt refs-check.mjs de bestaans-as
  # af tegen de eigen repo, en waarschuwen zou hier alleen ruis op legacy opleveren.
  set -- 'CLAUDE.md' 'profiles/*.md' '.claude/skills/*.md'
elif [ -f .umanex-os/profile ]; then
  set -- '.umanex-os/*.md' '.claude/skills/*.md'       # klant-repo: wat meereist
else
  set --
fi

if [ "$#" -gt 0 ]; then
  # Alleen toegevoegde regels (-U0, `^+`), en de `+++`-header eruit. Twee tot vier cijfers
  # — het laagste ooit aangehaalde PR-nummer is 19, en één cijfer is hier altijd een
  # rangtelwoord ("de #1 eerste zet"). Geen leidende nul: een PR-nummer begint nooit met
  # een 0, een hex-kleur vaak wel (`#000@30%` in een rowtrack-briefing las anders als 0):
  # een hex-kleur valt zo buiten bereik (#123456 heeft zes cijfers, #1a2b3c een letter
  # direct achter het cijfer), `umanex-apps#372` ook want daar staat
  # een woordteken vóór de #, en een markdown-kop `## ` heeft geen cijfer direct achter de #.
  ns_treffers="$(git diff --cached -U0 --diff-filter=ACMR -- "$@" 2>/dev/null \
    | grep -E '^[+]' | grep -v -E '^[+][+][+]' \
    | sed 's/`[^`]*`/ /g' \
    | grep -oE '(^|[^A-Za-z0-9_/#-])#[1-9][0-9]{1,3}([^0-9A-Za-z]|$)' \
    | grep -oE '#[1-9][0-9]{1,3}' | sort -u | tr '\n' ' ')"

  if [ -n "$ns_treffers" ]; then
    echo "⚠ Kaal PR-nummer in de gedeelde laag: $ns_treffers"
    echo "  Deze tekst reist naar elke klant-repo, en daar wijst hetzelfde nummer naar een"
    echo "  andere PR. Schrijf de repo erbij: umanex-apps#372 — GitHub maakt daar een link van."
    echo "  Harde toets: node scripts/refs-check.mjs (draait in CI, vraagt of de PR bestaat)."
  fi
fi

changed_apps="$(git diff --cached --name-only --diff-filter=ACMRD \
  | sed -n 's#^apps/\([^/]*\)/.*#\1#p' | sort -u)"

[ -z "$changed_apps" ] && exit 0

# 4. Context-snapshots.
#
# De uitkomst van gen-snapshot.sh wordt gecontroleerd, en de ✅ komt alleen als er ook echt
# iets gelukt is. Voorheen draaide de generator, mocht hij falen, werd de `git add` met
# `|| true` weggeslikt en verscheen daarna onvoorwaardelijk "✅ Snapshots toegevoegd aan
# commit" — de commit landde dan zonder snapshot terwijl het scherm zei van wel.
#
# Blokkeren doet dit blok niet: een kapotte snapshot is geen reden om werk tegen te houden.
# Maar het zégt wat er misging, en het liegt niet groen.
if [ -f ./scripts/gen-snapshot.sh ]; then
  echo "🔄 Context snapshots bijwerken..."
  snap_ok=0; snap_fail=""
  for app in $changed_apps; do
    [ -d "apps/$app" ] || continue
    if bash ./scripts/gen-snapshot.sh "$app"; then
      if git add "apps/$app/context-snapshot.md" 2>/dev/null; then
        snap_ok=$((snap_ok + 1))
      else
        snap_fail="$snap_fail $app(niet gestaged)"
      fi
    else
      snap_fail="$snap_fail $app(generator faalde)"
    fi
  done
  [ "$snap_ok" -gt 0 ] && echo "✅ $snap_ok snapshot(s) toegevoegd aan commit"
  if [ -n "$snap_fail" ]; then
    echo "⚠ Snapshot NIET bijgewerkt voor:$snap_fail"
    echo "  De commit gaat door, maar de context-snapshot van die app is nu stale."
  fi
fi

# 5. Design tokens — constants/ in sync houden met tokens.json.
#    Strikt gegateerd: alleen apps die een tokens:build-script én constants/ hebben.
for app in $changed_apps; do
  [ -d "apps/$app/constants" ] || continue
  grep -q '"tokens:build"' "apps/$app/package.json" 2>/dev/null || continue
  if command -v pnpm >/dev/null 2>&1; then
    echo "🎨 Design tokens ($app) herbouwen uit tokens.json..."
    if ( cd "apps/$app" && pnpm run tokens:build >/dev/null 2>&1 ); then
      git add "apps/$app/constants" 2>/dev/null || true
    else
      echo "✗ tokens:build faalde voor $app — commit gestopt. Fix de tokens/config en probeer opnieuw."
      exit 1
    fi
  else
    echo "⚠ pnpm niet gevonden — design-token-sync overgeslagen voor $app"
  fi
done

# 6. Parallel-werk-signaal — onvastgelegd werk in apps buiten deze commit.
#    Dat is op zichzelf legitiem (je bent aan twee dingen bezig), dus dit blokkeert niet.
#    Het maakt alleen het moment zichtbaar waarop een tweede taak in dezelfde working tree
#    leeft — het moment om die andere taak eerst af te ronden of te stashen, niet om een
#    tweede tree te maken (CLAUDE.md → Git workflow → Parallel werk).
#    context-snapshot.md telt niet mee: dat is hook-output, niet jouw tweede taak.
dirty_apps="$(git status --porcelain -- apps 2>/dev/null \
  | sed -n 's#^...apps/\([^/]*\)/.*#\1#p' | sort -u)"

parallel_apps=""
for app in $dirty_apps; do
  echo "$changed_apps" | grep -qx "$app" && continue
  git status --porcelain -- "apps/$app" 2>/dev/null \
    | grep -qv 'context-snapshot\.md$' || continue
  parallel_apps="$parallel_apps $app"
done

if [ -n "$parallel_apps" ]; then
  echo "⚠ Onvastgelegde wijzigingen buiten deze commit in:$parallel_apps"
  echo "  Twee taken in één working tree? Rond de andere eerst af of parkeer hem: git stash push -u -- apps/<app> — zie CLAUDE.md, Git workflow."
fi

# 7. Verify-pad-signaal — heeft de app die je aanraakt een uitvoerbaar verificatiepad?
#    Waarschuwt, blokkeert niet. Toen deze guard gebouwd werd had 1 van de 11 apps een
#    `## Verify-pad`-sectie; hard falen zou dus op dag één tien apps blokkeren en vooral
#    aanleren hoe je `--no-verify` typt. Door op *aanraking* te waarschuwen komt de druk
#    precies waar gewerkt wordt en blijven dormante apps buiten schot.
#
#    Waarom dit een guard is en geen instructie: de regel "een verify-pad is een
#    deliverable" stond al in twee skills, en in rowtrack viel de flow-as intussen twaalf
#    keer weg zonder dat er één item over het pad zélf ontstond. Instructie produceerde
#    daar netjes een regel per gemiste verificatie en nooit de infrastructuur.
#
#    Het contract staat in de `verify` skill: vijf capabilities (render vastleggen · flow
#    aandrijven · state forceren · invariant draaien · verse build), waarbij "geen" een
#    geldig antwoord is zolang het zichtbaar staat. Een eerlijke "geen" is het punt —
#    dan weet de Beoordeel-stap vooraf dat die as overgeslagen wordt.
#
#    PER ITEM, NIET PER POORT. Tot 2026-09-08 toetste dit blok alleen of de KOP bestond, en
#    een sectie die uit niets dan die kop bestaat kwam er even groen doorheen als een
#    volledig ingevulde — aantoonbaar: `printf '# x\n\n## Verify-pad\n' | grep -q '^## Verify-pad'`
#    slaagt. Een poort met een opsomming moet elk item van die opsomming meten; de kop is
#    het label van de sectie en niet haar inhoud. GEMETEN over de acht apps in umanex-apps:
#    zeven noemen alle vijf capabilities letterlijk, één noemt er één — dat is een terechte
#    waarschuwing, want "geen" is een geldig antwoord dat zichtbaar hoort te staan.
zonder_pad=""; pad_gaten=""
for app in $changed_apps; do
  [ -d "apps/$app" ] || continue
  md="apps/$app/CLAUDE.md"
  if [ ! -f "$md" ] || ! grep -q '^## Verify-pad' "$md"; then
    zonder_pad="$zonder_pad $app"
    continue
  fi
  blok="$(awk '/^## Verify-pad/{f=1;next} /^## /{f=0} f' "$md")"
  mis=""
  for cap in "render vastleggen" "flow aandrijven" "state forceren" "invariant draaien" "verse build"; do
    printf '%s' "$blok" | grep -qiF "$cap" || mis="$mis, $cap"
  done
  [ -n "$mis" ] && pad_gaten="$pad_gaten
    $app: mist ${mis#, }"
done

if [ -n "$zonder_pad" ]; then
  echo "⚠ Geen '## Verify-pad'-sectie in de CLAUDE.md van:$zonder_pad"
  echo "  Zonder dat pad valt de Beoordeel-stap terug op 'overgeslagen' zonder dat iemand het merkt."
  echo "  Vul de vijf capabilities in (render · flow · state · invariant · verse build);"
  echo "  'geen' is een geldig antwoord, mits zichtbaar. Zie de \`verify\` skill."
fi
if [ -n "$pad_gaten" ]; then
  echo "⚠ Verify-pad-sectie aanwezig maar onvolledig:$pad_gaten"
  echo "  Elk van de vijf capabilities hoort er te staan — óók met 'geen' als antwoord."
  echo "  Een kop zonder het item eronder maakt de as onmeetbaar zonder dat iets rood wordt."
fi

# 8. Design-systeem-bron-signaal — welke laag geeft de app die je aanraakt zijn vorm?
#    Waarschuwt, blokkeert niet, en precies zoals blok 6 alleen voor apps die in DEZE
#    commit veranderen. De harde toets staat in CI (`pnpm ds:guard`, met tegenproef);
#    dit is het vroege signaal, want CI spreekt pas ná de push.
#
#    Waarom dit een guard is en geen afspraak: `@umanex/ui` bestond in umanex-apps
#    maanden mét Storybook, mét Figma-sync en mét een CI-build, terwijl cashflow — het
#    grootste UI-oppervlak van die monorepo — hem in nul app-bestanden importeerde. De
#    dependency stond in package.json, `transpilePackages` stond in next.config.mjs, en
#    de enige importeur was een render-script. Een gedeelde componentlaag zichtbaar
#    maken is niet hetzelfde als hem gebruikt krijgen; zonder een sectie die zegt wat
#    de bron ís, valt dat verschil aan niets op.
#
#    Het contract is drie regels in `apps/<app>/CLAUDE.md`, onder `## Design-systeem-bron`:
#    Preset · Componentbron · Storybook. "geen" is overal een geldig antwoord zolang het
#    er staat — zelfde regime als het Verify-pad hierboven. Een lege regel laat de vraag
#    terugkomen, het woord "geen" maakt de keuze telbaar.
#    Ook hier per item: het contract is drie benoemde regels, dus drie metingen. GEMETEN op
#    de acht apps in umanex-apps: alle acht dragen alle drie de regels, dus deze vernauwing
#    kost nul nieuwe ruis en vangt alleen de sectie die alleen uit haar kop bestaat.
zonder_ds=""; ds_gaten=""
for app in $changed_apps; do
  [ -d "apps/$app" ] || continue
  md="apps/$app/CLAUDE.md"
  if [ ! -f "$md" ] || ! grep -q '^## Design-systeem-bron' "$md"; then
    zonder_ds="$zonder_ds $app"
    continue
  fi
  blok="$(awk '/^## Design-systeem-bron/{f=1;next} /^## /{f=0} f' "$md")"
  mis=""
  for k in Preset Componentbron Storybook; do
    printf '%s' "$blok" | grep -qE "^- \\*\\*$k:\\*\\*" || mis="$mis, $k"
  done
  [ -n "$mis" ] && ds_gaten="$ds_gaten
    $app: mist ${mis#, }"
done

if [ -n "$zonder_ds" ]; then
  echo "⚠ Geen '## Design-systeem-bron'-sectie in de CLAUDE.md van:$zonder_ds"
  echo "  Zonder die sectie is niet te zien welke preset, welke componentbron en welke"
  echo "  Storybook deze app gebruikt — en drift naar een eigen kopie valt aan niets op."
  echo "  Drie regels: - **Preset:** · - **Componentbron:** · - **Storybook:**"
  echo "  'geen' is een geldig antwoord, mits zichtbaar. De harde toets is 'pnpm ds:guard'."
fi
if [ -n "$ds_gaten" ]; then
  echo "⚠ Design-systeem-bron-sectie aanwezig maar onvolledig:$ds_gaten"
  echo "  Drie regels horen er te staan: - **Preset:** · - **Componentbron:** · - **Storybook:**"
fi
