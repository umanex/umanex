{
  "private": true,
  "name": "umanex",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:rowtrack": "pnpm --filter rowtrack start",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "plan:model": "node scripts/plan-model.mjs",
    "ds:guard": "node scripts/design-system-guard.mjs",
    "ds:guard:selftest": "node scripts/design-system-selftest.mjs && node scripts/design-system-guard.mjs"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "pnpm": {
    "overrides": {
      "styled-jsx>react": "18.3.1",
      "@types/react": "19.1.17",
      "@types/react-dom": "19.2.3"
    },
    "patchedDependencies": {
      "expo-router@6.0.23": "patches/expo-router@6.0.23.patch"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
