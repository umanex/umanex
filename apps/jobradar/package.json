{
  "name": "jobradar",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "flow": "node scripts/flow-harness.mjs",
    "scenarios": "node scripts/scenarios.mjs",
    "kbo:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve.mjs scripts/kbo-sync.mjs",
    "prospects:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve.mjs scripts/prospects-import.mjs",
    "opvolging:probe": "bash scripts/opvolging-probe.sh",
    "geocode": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve.mjs scripts/geocode.mjs"
  },
  "dependencies": {
    "@umanex/tokens": "workspace:*",
    "@umanex/ui": "workspace:*",
    "better-sqlite3": "^12.0.0",
    "drizzle-orm": "^0.45.0",
    "lucide-react": "^0.400.0",
    "next": "^14",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@umanex/config": "workspace:*",
    "autoprefixer": "^10",
    "drizzle-kit": "^0.31.0",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "ssh2-sftp-client": "^12.1.1",
    "tailwindcss": "^3",
    "typescript": "^5"
  }
}
